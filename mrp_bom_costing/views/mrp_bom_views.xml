<odoo>
    <record id="mrp_bom_form_view_cost" model="ir.ui.view">
        <field name="name">mrp.bom.form.cost</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field
                    name="next_production_cost"
                    widget="monetary"
                    options="{'currency_field': 'company_id'}"
                />
                <field name="next_production_cost_write_date" />
            </xpath>
        </field>
    </record>

    <record id="view_mrp_bom_tree_cost" model="ir.ui.view">
        <field name="name">mrp.bom.tree.cost</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field
                    name="next_production_cost"
                    widget="monetary"
                    options="{'currency_field': 'company_id'}"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
